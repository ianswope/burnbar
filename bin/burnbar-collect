#!/usr/bin/env python3
"""burnbar-collect — buckets Claude + Codex token burn into a rolling window.

Reads the raw agent transcripts (the only place per-turn token deltas carry
timestamps) and writes one small JSON the QML widget watches.

Python 3 with no third-party imports on purpose: Omarchy depends on uwsm and
kitty, both of which depend on python, so python3 is present on every Omarchy
install. bun is not an Omarchy dependency and cannot be assumed.

State lives under XDG_STATE_HOME, never inside the plugin directory: a plugin
writing in its own dir makes Omarchy rebuild every plugin service.

Claude:  ~/.claude/projects/**/*.jsonl   assistant lines carry message.usage.
         The same assistant message is re-serialized up to 3x as it streams,
         so message.id is a mandatory dedupe key.
Codex:   ~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl   event_msg lines with
         payload.type == "token_count" carry info.last_token_usage, already
         a per-turn delta.
"""

import datetime
import json
import os
import sys
import time
from pathlib import Path

HOME = Path.home()
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state")
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache")
# Omarchy's Claude collector keeps its last *successful* limits probe here.
PROBE_CACHE_DIR = CACHE / "omarchy" / "agent-usage"
OUT_DIR = STATE / "omarchy" / "burnbar"
OUT_FILE = OUT_DIR / "history.json"
CACHE_FILE = OUT_DIR / "scan-cache.json"
USAGE_DIR = STATE / "omarchy" / "agents" / "usage"

CLAUDE_ROOT = HOME / ".claude" / "projects"
CODEX_ROOT = HOME / ".codex" / "sessions"


def int_arg(flag, fallback, low, high):
    argv = sys.argv
    if flag in argv:
        i = argv.index(flag)
        if i + 1 < len(argv):
            try:
                return max(low, min(high, int(argv[i + 1])))
            except ValueError:
                pass
    return fallback


WINDOW_MIN = int_arg("--window", 360, 30, 1440)
BUCKETS = int_arg("--buckets", 12, 6, 32)
BUCKET_MS = round(WINDOW_MIN * 60_000 / BUCKETS)

now_ms = int(time.time() * 1000)
# Anchor to the bucket grid so cells march instead of jittering.
grid_now = (now_ms // BUCKET_MS) * BUCKET_MS
window_start = grid_now - (BUCKETS - 1) * BUCKET_MS

buckets = [{"t": window_start + i * BUCKET_MS, "claude": 0, "codex": 0}
           for i in range(BUCKETS)]


def bucket_for(ts):
    if ts < window_start:
        return None
    idx = (ts - window_start) // BUCKET_MS
    return buckets[idx] if 0 <= idx < BUCKETS else None


def parse_ts(value):
    """ISO-8601 with a trailing Z, as both agents emit. Returns epoch ms."""
    if not value:
        return None
    try:
        text = str(value).replace("Z", "+00:00")
        from datetime import datetime
        return int(datetime.fromisoformat(text).timestamp() * 1000)
    except Exception:
        return None


# ── incremental scan cache ───────────────────────────────────────────────────
# Transcripts are append-only, so a file whose size and mtime are unchanged
# contributes exactly what it contributed last run. Cache that contribution
# so the window sliding forward does not force a full re-read.
try:
    cache = json.loads(CACHE_FILE.read_text()) if CACHE_FILE.exists() else {}
    if not isinstance(cache, dict):
        cache = {}
except Exception:
    cache = {}
next_cache = {}


def scan(path, extract):
    """Return every point in `path`, re-parsing as little as possible.

    Transcripts are append-only, so a file that merely grew is read from the
    previous byte offset rather than from the start. Without this the active
    session's multi-megabyte transcript is re-parsed in full every few seconds,
    which is the whole cost of the collector.
    """
    try:
        st = path.stat()
    except OSError:
        return []
    # A file untouched since the window opened cannot hold points inside it.
    if st.st_mtime * 1000 < window_start:
        return []

    key = str(path)
    hit = cache.get(key)
    if hit and hit.get("size") == st.st_size and hit.get("mtime") == st.st_mtime:
        next_cache[key] = hit
        return hit["points"]

    # Resume only when the file strictly grew. A shrink means it was rewritten
    # and the cached offset is meaningless — and so does an equal size with a
    # new mtime, which is a rewrite that happens to be the same length.
    start = 0
    points = []
    if hit and isinstance(hit.get("offset"), int) \
            and st.st_size > (hit.get("size") or 0) and hit["offset"] <= st.st_size:
        start = hit["offset"]
        points = list(hit.get("points") or [])

    offset = start
    try:
        with path.open("rb") as fh:
            fh.seek(start)
            data = fh.read()
    except OSError:
        return []

    # Stop at the last newline: a trailing fragment is a half-written record,
    # and consuming it would both drop the record and desync the offset.
    cut = data.rfind(b"\n")
    if cut == -1:
        next_cache[key] = {"size": st.st_size, "mtime": st.st_mtime,
                           "offset": offset, "points": points}
        return points
    offset = start + cut + 1

    for raw in data[:cut].split(b"\n"):
        if not raw:
            continue
        pt = extract(raw.decode("utf-8", "replace"))
        if pt:
            points.append(pt)

    next_cache[key] = {"size": st.st_size, "mtime": st.st_mtime,
                       "offset": offset, "points": points}
    return points


# Both extractors treat a record as untrusted end to end: valid JSON with the
# wrong shape ("input_tokens": "unknown", "info": "bad") used to raise past
# the JSON guard and abort the whole collection for both agents — and the same
# record would do it again on every run.
MALFORMED = (TypeError, ValueError, AttributeError, KeyError)


def claude_extract(line):
    if "usage" not in line:
        return None
    try:
        d = json.loads(line)
        msg = d.get("message") or {}
        usage = msg.get("usage")
        if not isinstance(usage, dict):
            return None
        ts = parse_ts(d.get("timestamp"))
        if ts is None:
            return None
        # Billable work: fresh input + what we paid to write cache + output.
        # Cache reads are excluded on purpose — they are the cheap path and
        # would swamp the scale (939M read vs 24M written on the machine this
        # was built on).
        inp = int(usage.get("input_tokens") or 0)
        cache_w = int(usage.get("cache_creation_input_tokens") or 0)
        out = int(usage.get("output_tokens") or 0)
        tokens = inp + cache_w + out
        if tokens <= 0:
            return None
        # Cache reads ride along as a fifth field for the panel's "what did the
        # cache save you" row — they still never touch the heat map.
        cache_r = int(usage.get("cache_read_input_tokens") or 0)
        return [ts, tokens, str(msg.get("id") or ""), str(msg.get("model") or "unknown"),
                [inp, cache_w, out, cache_r]]
    except MALFORMED:
        return None


def codex_extract(line):
    if "token_count" not in line:
        return None
    try:
        d = json.loads(line)
        payload = d.get("payload") or {}
        if payload.get("type") != "token_count":
            return None
        last = (payload.get("info") or {}).get("last_token_usage")
        if not isinstance(last, dict):
            return None
        ts = parse_ts(d.get("timestamp"))
        if ts is None:
            return None
        inp = int(last.get("input_tokens") or 0)
        cache_r = int(last.get("cached_input_tokens") or 0)
        cache_w = int(last.get("cache_write_input_tokens") or 0)
        out = int(last.get("output_tokens") or 0)
        tokens = inp - cache_r + cache_w + out
        if tokens <= 0:
            return None
        return [ts, tokens, "", "codex", [max(0, inp - cache_r), cache_w, out, cache_r]]
    except MALFORMED:
        return None


def walk(root, match):
    if not root.is_dir():
        return
    for dirpath, _dirnames, filenames in os.walk(root):
        for name in filenames:
            if match(name):
                yield Path(dirpath) / name


# ── Claude ───────────────────────────────────────────────────────────────────
claude_by_model = {}
claude_seen = set()
claude_files = 0
# Split + activity, so the panel can answer "was that input or output" and
# "when did I last touch it" without a second pass over the transcripts.
claude_split = {"input": 0, "cacheWrite": 0, "output": 0, "cacheRead": 0}
claude_turns = 0
claude_first = 0
claude_last = 0


def add_split(target, part):
    # Points cached by an older collector carry no split; they still count
    # toward the heat map, they just cannot be attributed.
    if not isinstance(part, list) or len(part) != 4:
        return
    target["input"] += int(part[0] or 0)
    target["cacheWrite"] += int(part[1] or 0)
    target["output"] += int(part[2] or 0)
    target["cacheRead"] += int(part[3] or 0)


for f in walk(CLAUDE_ROOT, lambda n: n.endswith(".jsonl")):
    pts = scan(f, claude_extract)
    touched = False
    for pt in pts:
        ts, tokens, mid, model = pt[0], pt[1], pt[2], pt[3]
        if mid:
            if mid in claude_seen:
                continue
            claude_seen.add(mid)
        b = bucket_for(ts)
        if b is None:
            continue
        b["claude"] += tokens
        claude_by_model[model] = claude_by_model.get(model, 0) + tokens
        add_split(claude_split, pt[4] if len(pt) > 4 else None)
        claude_turns += 1
        claude_first = ts if not claude_first or ts < claude_first else claude_first
        claude_last = max(claude_last, ts)
        touched = True
    if touched:
        claude_files += 1

# ── Codex ────────────────────────────────────────────────────────────────────
codex_by_model = {}
codex_files = 0
codex_split = {"input": 0, "cacheWrite": 0, "output": 0, "cacheRead": 0}
codex_turns = 0
codex_first = 0
codex_last = 0

for f in walk(CODEX_ROOT, lambda n: n.startswith("rollout-") and n.endswith(".jsonl")):
    pts = scan(f, codex_extract)
    touched = False
    for pt in pts:
        ts, tokens = pt[0], pt[1]
        b = bucket_for(ts)
        if b is None:
            continue
        b["codex"] += tokens
        codex_by_model["codex"] = codex_by_model.get("codex", 0) + tokens
        add_split(codex_split, pt[4] if len(pt) > 4 else None)
        codex_turns += 1
        codex_first = ts if not codex_first or ts < codex_first else codex_first
        codex_last = max(codex_last, ts)
        touched = True
    if touched:
        codex_files += 1


# ── limits, straight off the records omarchy-agent-usage-update maintains ────
# The record is copied, not trusted. Three things travel with the numbers so
# the widget can tell a live figure from a leftover:
#   measuredAt — when the figure was actually measured. The record's own
#     updatedAt is stamped every time it is rewritten, and Omarchy's Claude
#     collector rewrites it with its *cached* limits when the probe fails or
#     the sign-in has lapsed, so updatedAt alone lets an old 0% wear a fresh
#     timestamp. The probe cache beside it (claude-limits.json) carries
#     fetchedAtMs, written only by a successful probe; that is the truth when
#     it exists. Codex keeps no fallback cache, so its updatedAt is honest.
#   status — the record's own words ("Sign-in expired", "Waiting for auth"),
#     or a note that the last probe failed and these are the last known.
#   percent — normalised per entry: anything that is not a finite 0..1
#     fraction becomes -1, an explicit "unknown", never 0 and never a crash.
# Whether a window has since rolled over is judged live in QML from resetsAt.
def parse_iso_ms(raw):
    raw = str(raw or "").strip()
    if not raw:
        return 0
    try:
        return int(datetime.datetime.fromisoformat(raw.replace("Z", "+00:00")).timestamp() * 1000)
    except ValueError:
        return 0


def norm_percent(value):
    try:
        n = float(value)
    except (TypeError, ValueError):
        return -1.0
    if n != n or n in (float("inf"), float("-inf")) or n < 0 or n > 1:
        return -1.0
    return n


def probe_measured_at(agent):
    try:
        cache = json.loads((PROBE_CACHE_DIR / f"{agent}-limits.json").read_text())
        return int(cache.get("fetchedAtMs") or 0) if isinstance(cache, dict) else 0
    except (OSError, ValueError, TypeError):
        return 0


def limits_for(agent):
    """Return (limits, measured_at_ms, status_text) for one agent record."""
    try:
        raw = json.loads((USAGE_DIR / f"{agent}.json").read_text())
    except (OSError, ValueError):
        return [], 0, ""
    if not isinstance(raw, dict):
        return [], 0, ""
    out = raw.get("limits")
    limits = [{"label": str(l.get("label") or "")[:64],
               "percent": norm_percent(l.get("percent")),
               "resetsAt": str(l.get("resetsAt") or "")[:40]}
              for l in out if isinstance(l, dict)] if isinstance(out, list) else []
    updated = parse_iso_ms(raw.get("updatedAt"))
    measured = probe_measured_at(agent) or updated
    # A probe cache newer than the record cannot be what produced the record.
    if updated and measured > updated:
        measured = updated
    status = str(raw.get("usageStatusText") or "")[:120]
    if not status and raw.get("retryAdvised") is True and limits:
        status = "last probe failed, showing last known"
    return limits, measured, status


claude_limits, claude_limits_at, claude_limits_status = limits_for("claude")
codex_limits, codex_limits_at, codex_limits_status = limits_for("codex")


payload = {
    "generatedAt": now_ms,
    "windowMinutes": WINDOW_MIN,
    "bucketMinutes": BUCKET_MS / 60_000,
    "bucketCount": BUCKETS,
    "buckets": buckets,
    "claude": {
        "total": sum(b["claude"] for b in buckets),
        "peak": max((b["claude"] for b in buckets), default=0),
        "peakAt": max(buckets, key=lambda b: b["claude"])["t"] if buckets else 0,
        "sessions": claude_files,
        "turns": claude_turns,
        "firstAt": claude_first,
        "lastAt": claude_last,
        "split": claude_split,
        "byModel": claude_by_model,
        "limits": claude_limits,
        "limitsMeasuredAt": claude_limits_at,
        "limitsStatus": claude_limits_status,
    },
    "codex": {
        "total": sum(b["codex"] for b in buckets),
        "peak": max((b["codex"] for b in buckets), default=0),
        "peakAt": max(buckets, key=lambda b: b["codex"])["t"] if buckets else 0,
        "sessions": codex_files,
        "turns": codex_turns,
        "firstAt": codex_first,
        "lastAt": codex_last,
        "split": codex_split,
        "byModel": codex_by_model,
        "limits": codex_limits,
        "limitsMeasuredAt": codex_limits_at,
        "limitsStatus": codex_limits_status,
    },
}

OUT_DIR.mkdir(parents=True, exist_ok=True)
# Write-then-rename so the watching FileView never observes a half file.
tmp = OUT_FILE.with_suffix(".json.tmp")
# allow_nan=False: a NaN would serialise as a bare NaN token, which is not JSON
# and would leave the widget holding whatever it parsed last.
tmp.write_text(json.dumps(payload, allow_nan=False))
tmp.replace(OUT_FILE)

try:
    CACHE_FILE.write_text(json.dumps(next_cache))
except OSError:
    pass  # the cache is an optimisation; losing it only costs one slow run

if "--print" in sys.argv:
    print(json.dumps(payload, indent=2))
