#!/usr/bin/env python3
"""Report Ollama availability and local inference activity as one JSON object."""

import argparse
import json
import math
import os
from pathlib import Path
import subprocess
import time
import urllib.error
import urllib.parse
import urllib.request


MAX_HTTP_RESPONSE_BYTES = 1024 * 1024
MAX_MODELS = 128
MAX_TEXT_LENGTH = 256
MAX_ERROR_LENGTH = 512


def bounded_text(value, limit: int = MAX_TEXT_LENGTH) -> str:
    text = str(value or "")
    text = "".join(character if character.isprintable() else " " for character in text)
    return text[:limit]


def normalize_url(url: str) -> str:
    url = url.strip()
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme.lower() in ("http", "https") and not parsed.netloc:
        raise ValueError("Ollama URL must use http or https with a host")
    url = url if "://" in url else "http://" + url
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme.lower() not in ("http", "https") or not parsed.netloc or not parsed.hostname:
        raise ValueError("Ollama URL must use http or https with a host")
    try:
        parsed.port
    except ValueError as error:
        raise ValueError("Ollama URL has an invalid port") from error
    return url.rstrip("/")


def reject_nonfinite(value: str):
    raise ValueError(f"non-finite JSON number: {value}")


def parse_finite_float(value: str) -> float:
    parsed = float(value)
    if not math.isfinite(parsed):
        reject_nonfinite(value)
    return parsed


def read_json_response(response) -> dict:
    raw = response.read(MAX_HTTP_RESPONSE_BYTES + 1)
    if len(raw) > MAX_HTTP_RESPONSE_BYTES:
        raise ValueError("Ollama response exceeds 1 MiB")
    payload = json.loads(raw.decode("utf-8"), parse_constant=reject_nonfinite,
                         parse_float=parse_finite_float)
    if not isinstance(payload, dict):
        raise ValueError("Ollama response must be a JSON object")
    return payload


def bounded_int(value, limit: int = 10**16) -> int:
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
        return 0
    return int(min(max(value, 0), limit))


def ollama_models(url: str) -> list[dict]:
    """Resident models with everything /api/ps knows about them: VRAM footprint,
    context length, quantisation and the keep-alive deadline. All bounded — this
    is the one place untrusted JSON turns into panel text."""
    with urllib.request.urlopen(normalize_url(url) + "/api/ps", timeout=0.8) as response:
        payload = read_json_response(response)
    models = payload.get("models", [])
    if not isinstance(models, list):
        return []
    safe_models = []
    for model in models[:MAX_MODELS]:
        if not isinstance(model, dict):
            continue
        name = bounded_text(model.get("name") or model.get("model"))
        if not name:
            continue
        details = model.get("details")
        details = details if isinstance(details, dict) else {}
        safe_models.append({
            "name": name,
            "size": bounded_int(model.get("size")),
            "sizeVram": bounded_int(model.get("size_vram")),
            "contextLength": bounded_int(model.get("context_length"), 10**9),
            "expiresAt": bounded_text(model.get("expires_at"), 64),
            "parameters": bounded_text(details.get("parameter_size"), 32),
            "quantization": bounded_text(details.get("quantization_level"), 32),
            "family": bounded_text(details.get("family"), 32),
        })
    return safe_models


def ollama_version(url: str) -> str:
    try:
        with urllib.request.urlopen(normalize_url(url) + "/api/version", timeout=0.5) as response:
            payload = read_json_response(response)
        return bounded_text(payload.get("version"), 32)
    except (OSError, urllib.error.URLError, json.JSONDecodeError, UnicodeDecodeError, ValueError):
        return ""


def runner_ticks() -> tuple[int, int]:
    total = 0
    count = 0
    for proc in Path("/proc").glob("[0-9]*"):
        try:
            command = (proc / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="ignore")
            if "ollama runner" not in command and "ollama_llama_server" not in command:
                continue
            fields = (proc / "stat").read_text().split()
            total += int(fields[13]) + int(fields[14])
            count += 1
        except (OSError, ValueError, IndexError):
            continue
    return total, count


def cpu_load(sample_seconds: float = 0.20) -> float:
    before, count = runner_ticks()
    if count == 0:
        return 0.0
    time.sleep(sample_seconds)
    after, _ = runner_ticks()
    ticks = max(0, after - before)
    hz = os.sysconf("SC_CLK_TCK")
    cores = max(1, os.cpu_count() or 1)
    return min(100.0, ticks / hz / sample_seconds / cores * 100.0)


def gpu_load() -> tuple[float, str]:
    commands = [
        (["nvidia-smi", "--query-gpu=utilization.gpu", "--format=csv,noheader,nounits"], "nvidia"),
        (["rocm-smi", "--showuse", "--json"], "rocm"),
    ]
    for command, backend in commands:
        try:
            result = subprocess.run(command, capture_output=True, text=True, timeout=0.7, check=False)
            if result.returncode != 0:
                continue
            if backend == "nvidia":
                values = [float(line.strip()) for line in result.stdout.splitlines() if line.strip()]
            else:
                data = json.loads(result.stdout)
                if not isinstance(data, dict):
                    raise ValueError("rocm-smi response must be a JSON object")
                values = [float(str(value).strip("%")) for card in data.values()
                          if isinstance(card, dict)
                          for key, value in card.items() if "GPU use" in key]
            values = [value for value in values if math.isfinite(value) and 0 <= value <= 100]
            if values:
                return max(values), backend
        except (OSError, ValueError, subprocess.SubprocessError, json.JSONDecodeError):
            continue
    return 0.0, "cpu"


def parse_smi_number(text: str) -> float:
    """nvidia-smi prints [N/A] for anything the board does not expose — a
    laptop 4050 has no power limit or fan readout. Absent reads as 0, and the
    panel hides a zero-valued gauge rather than drawing a lie."""
    try:
        value = float(str(text).strip())
    except ValueError:
        return 0.0
    return value if math.isfinite(value) and value >= 0 else 0.0


def gpu_stats() -> dict:
    """Power, thermals, memory and clocks off nvidia-smi in one call. Empty on
    any failure: a machine without an NVIDIA GPU simply gets no GPU block."""
    fields = ["name", "power.draw", "power.limit", "temperature.gpu",
              "memory.used", "memory.total", "clocks.sm", "clocks.max.sm", "fan.speed"]
    try:
        result = subprocess.run(
            ["nvidia-smi", "--query-gpu=" + ",".join(fields), "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=0.7, check=False)
    except (OSError, subprocess.SubprocessError):
        return {}
    if result.returncode != 0:
        return {}
    line = next((l for l in result.stdout.splitlines() if l.strip()), "")
    parts = [p.strip() for p in line.split(",")]
    if len(parts) != len(fields):
        return {}
    return {
        "gpuName": bounded_text(parts[0], 64),
        "powerW": round(parse_smi_number(parts[1]), 1),
        "powerLimitW": round(parse_smi_number(parts[2]), 1),
        "tempC": round(parse_smi_number(parts[3])),
        "vramUsedMb": round(parse_smi_number(parts[4])),
        "vramTotalMb": round(parse_smi_number(parts[5])),
        "clockMhz": round(parse_smi_number(parts[6])),
        "clockMaxMhz": round(parse_smi_number(parts[7])),
        "fanPct": round(parse_smi_number(parts[8])),
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--threshold", type=float, default=8.0)
    parser.add_argument("--url", default=os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434"))
    args = parser.parse_args()
    try:
        models = ollama_models(args.url)
    except (OSError, urllib.error.URLError, json.JSONDecodeError, UnicodeDecodeError, ValueError) as error:
        print(json.dumps({"online": False, "active": False, "load": 0, "modelCount": 0,
                          "model": "", "backend": "none",
                          "error": bounded_text(error, MAX_ERROR_LENGTH)}))
        return 0

    gpu, backend = gpu_load()
    cpu = cpu_load()
    load = round(max(cpu, gpu), 1)
    names = [model["name"] for model in models]
    payload = {"online": True, "active": load >= args.threshold, "load": load,
               "modelCount": len(models), "model": names[0] if names else "",
               "models": names, "modelDetails": models, "backend": backend,
               "cpu": round(cpu, 1), "gpu": round(gpu, 1),
               "version": ollama_version(args.url),
               "vramModelsMb": round(sum(m["sizeVram"] for m in models) / 1048576)}
    payload.update(gpu_stats())
    print(json.dumps(payload))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
